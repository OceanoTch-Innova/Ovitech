{
  "name": "ovitech-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build --config=wrangler.jsonc && opennextjs-cloudflare preview --config=wrangler.jsonc",
    "deploy": "opennextjs-cloudflare build --config=wrangler.jsonc && opennextjs-cloudflare deploy --config=wrangler.jsonc",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.14.0",
    "next": "15.5.4",
    "nodemailer": "6.10.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "typescript": "5.8.3",
    "wrangler": "4.141.0"
  }
}
